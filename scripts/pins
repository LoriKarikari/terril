#!/usr/bin/env bash
# Prints one row per pinned version: file, name, pinned, latest, and "outdated" when they differ.
# It exits non-zero, naming the pin, when it can't read a pin or look up its latest version.
set -euo pipefail
cd "$(dirname "$0")/.."

fail() {
    echo "$1" >&2
    exit 1
}

shape() { sed -E 's/[0-9]+/[0-9]+/g; s/\./\\./g' <<<"$1"; }

newest() { grep -E "^$(shape "$1")\$" | sort -V | tail -1; }

docker_tags() {
    local name=$1
    if [[ $name == ghcr.io/* ]]; then
        local repo=${name#ghcr.io/} token
        token=$(curl -fsS "https://ghcr.io/token?scope=repository:$repo:pull" | jq -r .token)
        local url="https://ghcr.io/v2/$repo/tags/list?n=1000"
        while [[ -n $url ]]; do
            local headers
            headers=$(mktemp)
            curl -fsS -D "$headers" -H "Authorization: Bearer $token" "$url" | jq -r '.tags[]'
            url=$(grep -i '^link:' "$headers" | grep -oP '<\K[^>]+' || true)
            [[ -z $url ]] || url=https://ghcr.io$url
            rm -f "$headers"
        done
        return
    fi
    [[ $name == */* ]] || name=library/$name
    local url="https://hub.docker.com/v2/repositories/$name/tags?page_size=100&ordering=last_updated"
    for _ in 1 2 3; do
        local page
        page=$(curl -fsS "$url")
        jq -r '.results[].name' <<<"$page"
        url=$(jq -r '.next // empty' <<<"$page")
        [[ -n $url ]] || break
    done
}

# FrankenPHP rebuilds the binaries of its newest release every night, so release=superseded
# proposes the newest release that already has a newer one.
releases() {
    local name=$1 which=$2
    local tags
    tags=$(gh api "repos/$name/releases?per_page=20" --jq '.[] | select(.prerelease or .draft | not) | .tag_name')
    case $which in
    latest) head -1 <<<"$tags" ;;
    superseded) sed -n 2p <<<"$tags" ;;
    *) fail "unknown release=$which" ;;
    esac
}

latest() {
    local source=$1 name=$2 current=$3 which=$4
    case $source in
    go) curl -fsS "https://proxy.golang.org/$name/@latest" | jq -r .Version ;;
    docker) docker_tags "$name" | newest "$current" ;;
    pypi) curl -fsS "https://pypi.org/pypi/$name/json" | jq -r .info.version ;;
    npm) curl -fsS "https://registry.npmjs.org/$name/latest" | jq -r .version ;;
    github-releases) releases "$name" "$which" ;;
    *) fail "unknown datasource=$source" ;;
    esac
}

row() {
    [[ -n $4 ]] || fail "$1: can't look up the latest version of $2"
    local status=""
    [[ $3 == "$4" ]] || status=outdated
    printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$status"
}

hits=$(grep -rn -E '^(//|#) pin: ' pack justfile | cut -d: -f1,2)
while IFS= read -r hit; do
    file=${hit%%:*}
    line=${hit#*:}
    marker=$(sed -n "${line}p" "$file")
    next=$(sed -n "$((line + 1))p" "$file")
    source=$(grep -oP 'datasource=\K\S+' <<<"$marker") || fail "$file:$line: the pin has no datasource="
    name=$(grep -oP 'depName=\K\S+' <<<"$marker") || fail "$file:$line: the pin has no depName="
    which=$(grep -oP 'release=\K\S+' <<<"$marker" || echo latest)
    if [[ $source == github-release-attachments ]]; then
        release=$(grep -oP 'digestVersion=\K\S+' <<<"$marker") || fail "$file:$line: the pin has no digestVersion="
        version=$(grep -h -A1 -E "pin: datasource=github-releases depName=$name( |\$)" pack/*.go | grep -oP 'const \w+ = "\K[^"]+') ||
            fail "$file:$line: no github-releases pin for $name"
        row "$file:$line" "$name checksum" "$release" "$version"
        continue
    fi
    current=$(grep -oP 'const \w+ = "\K[^"]+|:= "[^"]*@\K[^"]+' <<<"$next") ||
        fail "$file:$((line + 1)): can't read the pinned version below the pin comment"
    found=$(latest "$source" "$name" "$current" "$which") || fail "$file:$line: can't look up the latest version of $name"
    row "$file:$line" "$name" "$current" "$found"
done <<<"$hits"

while IFS= read -r hit; do
    [[ -n $hit ]] || continue
    file=${hit%%:*}
    rest=${hit#*:}
    line=${rest%%:*}
    action=$(grep -oP 'uses: \K[^@]+' <<<"$rest")
    current=$(grep -oP '# \Kv\S+' <<<"$rest") || fail "$file:$line: pin $action by commit SHA with its version in a comment"
    found=$(gh api "repos/$action/releases/latest" --jq .tag_name) || fail "$file:$line: can't look up the latest version of $action"
    row "$file:$line" "$action" "$current" "$found"
done < <(grep -Hn 'uses: ' .github/workflows/*.yml)

modules=$(go list -m -u -f '{{if and (not .Indirect) (not .Main)}}{{.Path}} {{.Version}} {{with .Update}}{{.Version}}{{end}}{{end}}' all)
while read -r path version update; do
    [[ -n $path ]] && row go.mod "$path" "$version" "${update:-$version}"
done <<<"$modules"
